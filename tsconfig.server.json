{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "noEmit": false,
    "sourceMap": true
  },
  "include": ["src/server", "src/db.ts"],
  "exclude": ["node_modules", "dist", "src/pages", "src/components", "src/contexts", "src/utils"]
}
