# =====================================================
# SECTOR NINE INITIATIVE — Environment Variables
# Copy this file to .env and fill in your values
# =====================================================

# PostgreSQL — your local Windows install
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/sectornine"

# JWT — change this to a long random string, keep it secret
JWT_SECRET="sector-nine-change-this-to-something-very-long-and-random"

# Express server port
PORT=3001

# Vite frontend points at the Express server
VITE_API_URL=http://localhost:3001

# Steam API key — get yours free at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# Steam OAuth return URL — must match exactly what you register on Steam
# For local dev: http://localhost:3000/auth/steam/callback
# For production: https://yourdomain.com/auth/steam/callback
STEAM_RETURN_URL=http://localhost:3000/auth/steam/callback
