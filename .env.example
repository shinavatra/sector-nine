# =====================================================
# SECTOR NINE INITIATIVE — Environment Variables
# Copy this file to .env and fill in your values
# =====================================================

# PostgreSQL — your local Windows install
DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/sectornine"

# JWT — change this to a long random string, keep it secret
JWT_SECRET="sector-nine-change-this-to-something-very-long-and-random"

# 32-byte RCON encryption key encoded as 64 hexadecimal characters.
# Generate once with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RCON_ENCRYPTION_KEY=replace_with_64_hex_characters

# Express server port
PORT=3001

# Serve the Vite production build from Express. Keep false for a dedicated API service;
# set true only for a combined deployment where npm run build creates build/index.html.
SERVE_FRONTEND=false

# Structured HTTP/application log threshold: info, warn, or error.
LOG_LEVEL=info

# Comma-separated frontend origins allowed to call the API.
# Production startup fails when this value is missing.
APP_ORIGIN=http://localhost:3000

# Vite frontend points at the Express server
VITE_API_URL=http://localhost:3001

# Steam API key — get yours free at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your_steam_api_key_here

# Public frontend URL used in email links. Must use HTTPS in production.
PUBLIC_APP_URL=http://localhost:3000

# Password reset email delivery. Production requires this to be enabled and configured.
PASSWORD_RESET_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
SMTP_FROM="Sector Nine <support@example.com>"

# Optional PostgreSQL client paths for Windows backup and restore drills.
# Use the same major client version as the database server.
PG_DUMP_PATH="C:\\Program Files\\PostgreSQL\\18\\bin\\pg_dump.exe"
PG_RESTORE_PATH="C:\\Program Files\\PostgreSQL\\18\\bin\\pg_restore.exe"
BACKUP_DIR=scripts/backups
